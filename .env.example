# Скопируй в .env и подставь значения. Все VITE_* запекаются в бандл на этапе
# `npm run build` — на работающем приложении их не поменять без пересборки.

# Базовый URL бэкенда (дев-стенд: https://dev-api.qazyna.ai)
VITE_API_BASE_URL=

# URL form-configs-server (локально: http://localhost:3001)
VITE_FORM_CONFIGS_URL=

# Требовать вход (SCRUM-373). Пусто или что угодно кроме 'true' — выключено.
VITE_AUTH_ENABLED=

# Отключить вспышку при face-auth (для локальной разработки)
VITE_FACE_FLASH_DISABLED=

# ANTHROPIC_API_KEY здесь НЕ хранится: фронту он не нужен, form-configs-server
# получает его в рантайме (локально — экспортом в окружение, в k8s — секретом
# fin-web-secret). Никогда не класть ключи в .env, попадающий в билд.
